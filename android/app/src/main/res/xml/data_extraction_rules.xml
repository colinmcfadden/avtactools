<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to another device: LZ locations stay out of consumer clouds, and the server is the
     backup (docs/NATIVE_APPS_PLAN.md, "Data model and local storage"). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
