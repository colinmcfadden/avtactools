# --- DEPENDENCIES ---
/node_modules/
*/node_modules/
/venv
/.venv
/env
__pycache__/
*.py[cod]
*$py.class

# --- NEXT.JS / REACT ---
.next/
out/
build/
dist/
.vercel

# --- ENVIRONMENT VARIABLES (Security Risk!) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- PYTHON / FLASK SPECIFIC ---
*.db
# The SQLite files the contract tests read are test fixtures, not data: a clean checkout (CI) needs them.
!contracts/fixtures/sqlite/*.db
instance/
.pytest_cache/
.coverage
htmlcov/
celerybeat-schedule

# --- IDE & SYSTEM SETTINGS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- LOGS ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
flask.log
*.log

# --- PROJECT SPECIFIC EXPORTS (Don't commit these!) ---
# These are the files generated by your Terrain/LZ analysis tools
*.pt
LZ_Export_*
LZ_Diagram_*
LZ_Map_Layer_*

# Approved local terrain data must remain outside source control.
/backend/terrain-data/
/backend/dted/
/topo/

# Cesium static assets and generated LiDAR tilesets are build output, copied or
# generated on demand rather than committed.
/frontend/public/cesium/
/frontend/public/tiles/

# Downloaded LiDAR indexes: the USGS coverage GeoJSON (~8 MB) and the per-
# collection tile index are both regenerated on demand.
usgs_ept_coverage.geojson
tile_index.json

# --- ANDROID / GRADLE ---
# Build output (build/ is ignored above), the Gradle cache, and per-machine files.
.gradle/
.kotlin/
android/local.properties
# Android Studio writes the JDK that runs Gradle here ("updateDaemonJvm"); which JDK that is, is each machine's own
# choice (android/gradle.properties says so), and CI's JDK 21 would otherwise be made to fetch another one.
android/gradle/gradle-daemon-jvm.properties
*.iml
# Signing material never goes in the repository (docs/NATIVE_APPS_PLAN.md, "Signing and delivery").
*.jks
*.keystore
*.p12

# --- NATIVE DESIGN HANDOFF ---
# The screens themselves (82 screenshots, ~25 MB, and their HTML sources) stay local: the Design canvas is the
# original (docs/native-design/README.md). The README, outlines and tokens are committed.
/docs/native-design/png/
/docs/native-design/screens/
