# API the SPA talks to.
REACT_APP_API_URL=http://127.0.0.1:5000/api

# Where the 3D window tells you to run a point-cloud build. Builds belong
# wherever the LiDAR and the tileset store live — for a self-hosted backend
# that is the server, not a workstation.
REACT_APP_LIDAR_BUILD_CWD=/opt/avtactools

# A downloaded 3DEP collection to build from, instead of querying AWS. Reading
# local tiles is disk-speed; the remote fetch dominates every build.
REACT_APP_LIDAR_COLLECTION=/data/lidar
