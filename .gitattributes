# The owner works on Windows; the Gradle wrapper script must stay LF or it
# fails on Linux (CI, Coolify) with "bad interpreter", and the Windows batch
# file must stay CRLF.
android/gradlew text eol=lf
android/**/*.sh text eol=lf
*.bat text eol=crlf

# Fixtures are compared byte for byte. A .msnx is a zip, so no line-ending
# conversion may touch it; the JSON ones stay LF so a Windows checkout
# regenerates to the same bytes.
*.msnx binary
contracts/fixtures/**/*.json text eol=lf
# The pre-rendered symbols, and milsymbol as the app bundles it (a test holds it
# byte for byte to the web's node_modules copy): a CRLF checkout fails both.
contracts/fixtures/**/*.svg text eol=lf
android/core-symbols/src/main/assets/*.js text eol=lf
