# Copy to .env for local development. wsgi.py loads it with python-dotenv.
# Production sets these in the host's environment (Coolify / Fly), never in a file.
# Every value below is a placeholder.

# --- Required in production -------------------------------------------------
# Signs login tokens. At least 32 characters. Startup refuses to run without
# it whenever TRUSTED_PROXY, FLY_APP_NAME or APP_ENV=production is set.
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars

# Postgres URL (use Supabase's Session-mode pooler). Leave unset locally to use
# the SQLite file backend/ezpz.db.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Comma-separated browser origins allowed to call the API. The name is plural;
# CORS_ORIGIN is silently ignored.
CORS_ORIGINS=http://localhost:3000

# --- Where the app is hosted -------------------------------------------------
# fly | cloudflare. Says which header holds the client IP, and also switches
# on the production start-up checks.
# TRUSTED_PROXY=cloudflare
# APP_ENV=production
# SESSION_COOKIE_SECURE=true

# --- Accounts and email ------------------------------------------------------
GOOGLE_CLIENT_ID=
SUPER_ADMIN_EMAIL=
# ADMIN_SESSION_SECRET=            # defaults to JWT_SECRET_KEY
FRONTEND_URL=http://localhost:3000
# NEW_ACCOUNT_NOTIFY_EMAIL=

# Production needs both of these. Locally, EMAIL_DELIVERY_MODE=console prints
# the verification links to the Flask log instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=EZ/PZ <noreply@example.com>
EMAIL_DELIVERY_MODE=console

# --- Terrain -----------------------------------------------------------------
# Folder of USGS DEMs (os.pathsep-separated). Unset -> Terrarium tiles only.
# TERRAIN_DATA_DIR=C:\_dev\avtactools\topo
# TERRAIN_SOURCE=auto              # auto | local | terrarium
# TERRAIN_TILE_CACHE_DIR=          # persistent folder in production; 'none' disables
# TERRAIN_WARM_LEVEL=9             # -1 disables the start-up warm-up
# TERRAIN_REQUIRE_GEOID=

# Local dev only: lets PROJ download geoid grids it does not have installed.
# PROJ_NETWORK=ON

# --- 3D view / LiDAR ---------------------------------------------------------
# The build service is a separate container; unset -> no on-demand builds.
# LIDAR_BUILDER_URL=http://lidar-builder:8090
# LIDAR_BUILDER_TOKEN=             # shared secret with the build service
# LIDAR_TILES_DIR=/data/tiles
# LIDAR_CACHE_DIR=/data/cache
